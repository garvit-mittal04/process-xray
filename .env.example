# Copy this file to .env and put your real keys there. Never commit .env.
GEMINI_API_KEY=your-gemini-key            # free: aistudio.google.com

# Optional free fallbacks (used automatically when Gemini is busy or out of quota)
# GROQ_API_KEY=your-groq-key              # free: console.groq.com
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=your-openrouter-key  # free models: openrouter.ai
# OPENROUTER_MODEL=some-model:free

# Optional: override the whole order, e.g.
# LLM_MODELS=gemini-2.5-flash,groq:llama-3.3-70b-versatile,gemini-flash-lite-latest
